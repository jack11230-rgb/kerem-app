# Database (SQLite file for local/single-server; libsql:// URL for Turso)
DATABASE_URL=file:./data/kerem.db
# DATABASE_AUTH_TOKEN=            # only for Turso/libsql remote

# AI (any OpenAI-compatible API). Leave AI_API_KEY empty to run in offline fallback mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Tuning
ROOM_ARCHIVE_HOURS=24
REMINDER_MINUTES=15

# Uploads (admin media uploads; mount a volume in production)
# UPLOAD_DIR=./data/uploads
# Set to 1 when served over HTTPS (marks the session cookie Secure)
# COOKIE_SECURE=1
# Protects GET /api/cron?key=... on serverless hosts
# CRON_SECRET=
